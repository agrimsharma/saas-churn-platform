        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ customer_id: $json.customer_id, action: $json.action, details: { churn_probability: $json.churn_probability, offer: $json.offer, drivers: $json.drivers } }) }}",
        "options": {}
      },
      "id": "da1eca1c-4ef7-5b49-afc7-f14f3a8ddaa1",
      "name": "Queue retention email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// One Slack message per run instead of one per customer. Skipped if SLACK_WEBHOOK_URL is unset.\nif (!$env.SLACK_WEBHOOK_URL) return [];\n\nconst rows = $input.all().map(i => i.json);\nconst high = rows.filter(r => r.tier === 'high').sort((a, b) => b.churn_probability - a.churn_probability);\nconst medium = rows.filter(r => r.tier === 'medium');\nconst revenueAtRisk = high.concat(medium).reduce((s, r) => s + (r.monthly_charges || 0), 0);\n\nconst lines = high.slice(0, 5).map(r =>\n  `\u2022 *${r.customer_id}* - ${(r.churn_probability * 100).toFixed(0)}% - ${r.drivers.join(', ')} \u2192 _${r.offer}_`\n);\nconst text = [\n  `*Churn scan:* ${rows.length} customers scored - ${high.length} high risk (call), ${medium.length} medium (email).`,\n  `Monthly revenue at risk: $${revenueAtRisk.toFixed(2)}`,\n  ...(lines.length ? ['*Top high-risk:*', ...lines] : []),\n].join('\\n');\nreturn [{ json: { text } }];"
      },
      "id": "f94a684e-dea7-57ad-9e0f-2859678b7c30",
      "name": "Build Slack digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
