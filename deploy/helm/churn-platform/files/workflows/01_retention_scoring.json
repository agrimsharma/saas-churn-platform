        "options": {}
      },
      "id": "db2bc16a-6d54-5ecb-bc26-3ee02a2ba6d2",
      "name": "Create call task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.CHURN_API_URL }}/actions",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.CHURN_API_KEY }}"
            }
