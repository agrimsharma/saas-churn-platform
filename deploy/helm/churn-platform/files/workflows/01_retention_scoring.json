      "id": "7a4eeae5-73d6-5970-8a56-4f4c04959527",
      "name": "Score churn risk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Retention playbook: the business rules live here (editable without redeploying the model).\n// churn_probability is calibrated (isotonic, out-of-fold): 0.6 means ~60% of such customers churn.\n// On the Telco base (26.5% churn) HIGH flags ~13% of customers, MEDIUM another ~25%.\nconst HIGH = 0.6;\nconst MEDIUM = 0.35;\n\nconst customers = Object.fromEntries(\n  $('Pull active customers').first().json.customers.map(c => [c.customerID, c])\n);\n\nfunction pickOffer(c) {\n  if (c.Contract === 'Month-to-month') return '15% off for switching to a 1-year contract';\n  if (c.TechSupport === 'No' && c.InternetService !== 'No') return '3 months of free tech support';\n  if (c.PaymentMethod === 'Electronic check') return '$5/month credit for enabling autopay';\n  return 'loyalty check-in, no discount';\n}\n\nconst out = [];\nfor (const item of $input.all()) {\n  for (const p of item.json.predictions) {\n    const c = customers[p.customer_id] || {};\n    const tier = p.churn_probability >= HIGH ? 'high' : p.churn_probability >= MEDIUM ? 'medium' : 'low';\n    out.push({ json: {\n      customer_id: p.customer_id,\n      churn_probability: p.churn_probability,\n      tier,\n      action: { high: 'retention_call', medium: 'retention_email', low: 'none' }[tier],\n      offer: tier === 'low' ? null : pickOffer(c),\n      monthly_charges: c.MonthlyCharges,\n      tenure_months: c.tenure,\n      drivers: p.top_risk_factors.map(f => `${f.feature} = ${f.value}`),\n    }});\n  }\n}\nreturn out;"
      },
      "id": "89739313-09d4-567e-b79f-2bc74ab0f642",
      "name": "Apply retention playbook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "b7586940-d409-5fb2-991a-404af7cc4904",
                    "leftValue": "={{ $json.tier }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "high"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "high"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "effb48c6-b525-528a-9c3f-0ecefa8f8c2c",
                    "leftValue": "={{ $json.tier }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "medium"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "medium"
            }
          ]
        },
        "options": {}
      },
      "id": "6509f726-d103-5ad4-9fb5-9410008fb7ae",
      "name": "Route by risk tier",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1340,
