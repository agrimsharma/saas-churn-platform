# copy to .env and fill in
API_KEY=change-me
# optional: Slack incoming-webhook URL for digests/alerts (leave blank to skip Slack)
SLACK_WEBHOOK_URL=
# true = also install torch/transformers so /classify works (~1 GB bigger image)
WITH_NLP=false
TZ=UTC
# local Postgres (pgvector) password for the complaints index
POSTGRES_PASSWORD=churn
# optional: Claude API key for /complaints/draft - paste it here yourself; .env is gitignored
ANTHROPIC_API_KEY=
